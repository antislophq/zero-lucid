{
  "name": "@antislop/zero-lucid",
  "version": "0.1.0",
  "description": "Adonis Lucid database adapter for Zero server mutators",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
